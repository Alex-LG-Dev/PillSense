<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Notificaciones de las tomas (desde Android 13 hay que pedírselas al usuario) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Alarmas exactas, para avisar a la hora justa de cada toma -->
    <!-- Android 13 o superior: se concede solo, sin preguntar -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- Android 12: el mismo permiso con otro nombre -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PillSense">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.PillSense.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Pantalla de inicio de sesión -->
        <activity
            android:name=".LoginActivity"
            android:exported="false" />

        <!-- Pantalla de registro -->
        <activity
            android:name=".RegistroActivity"
            android:exported="false" />

        <meta-data
            android:name="com.facebook.sdk.ApplicationId"
            android:value="@string/facebook_app_id" />
        <meta-data
            android:name="com.facebook.sdk.ClientToken"
            android:value="@string/facebook_client_token" />

        <!-- Pantalla Acerca de (se abre desde el menú de la barra de acciones) -->
        <activity
            android:name=".AcercaDeActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".PrincipalActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Añadir / editar medicamento -->
        <activity
            android:name=".MedicamentoActivity"
            android:exported="false"
            android:parentActivityName=".PrincipalActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- Perfil -->
        <activity
            android:name=".PerfilActivity"
            android:exported="false"
            android:parentActivityName=".PrincipalActivity" />

        <!-- Editar perfil: cambiar datos y contraseña -->
        <activity
            android:name=".EditarPerfilActivity"
            android:exported="false"
            android:parentActivityName=".PerfilActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- Cambiar contraseña (T036) -->
        <activity
            android:name=".CambiarContrasenaActivity"
            android:exported="false"
            android:parentActivityName=".EditarPerfilActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- Crear / editar toma -->
        <activity
            android:name=".TomaActivity"
            android:exported="false"
            android:parentActivityName=".PrincipalActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- Pantalla principal del paciente -->
        <activity
            android:name=".PacienteActivity"
            android:exported="false" />

        <!-- "¡Muy bien!" al tomar una pastilla -->
        <activity
            android:name=".TomaRegistradaActivity"
            android:exported="false" />

        <!-- Pastillas de hoy (paciente) -->
        <activity
            android:name=".PastillasHoyActivity"
            android:exported="false"
            android:parentActivityName=".PacienteActivity" />

        <!-- Pedir ayuda (paciente) -->
        <activity
            android:name=".PedirAyudaActivity"
            android:exported="false" />

        <!-- Aviso de toma: "Es hora de tu pastilla"  -->
        <activity
            android:name=".AvisoTomaActivity"
            android:exported="false" />

        <!-- Saca la notificación cuando llega la hora de una toma -->
        <receiver
            android:name=".AlarmaTomaReceiver"
            android:exported="false" />


    </application>


</manifest>