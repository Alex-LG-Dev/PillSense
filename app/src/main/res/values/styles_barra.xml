<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Título de la barra de acciones: Atkinson, negrita, mismo tamaño que los títulos de las pantallas -->
    <style name="TextAppearance.PillSense.TituloBarra" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">@dimen/texto_boton</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/atkinson_hyperlegible</item>
        <item name="fontFamily">@font/atkinson_hyperlegible</item>
    </style>
        <!-- Texto de las pestañas de abajo: pequeño y sin mayúsculas -->
        <style name="TextAppearance.PillSense.Pestana" parent="TextAppearance.MaterialComponents.Caption">
            <item name="android:textSize">12sp</item>
            <item name="android:textAllCaps">false</item>
            <item name="fontFamily">@font/atkinson_hyperlegible</item>
        </style>
    <!-- ===== Historial: estilos que se repiten en la tabla y la leyenda ===== -->

    <!-- Hora de la cabecera de la tabla (8:00, 9:00...) -->
    <style name="Historial.HoraTabla" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/texto_secundario</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- Cada elemento de la leyenda (punto + texto) ocupa media fila -->
    <style name="Historial.Leyenda" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <!-- Texto de la leyenda -->
    <style name="Historial.TextoLeyenda" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:textColor">@color/texto_principal</item>
        <item name="android:textSize">15sp</item>
    </style>

</resources>
