<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.PillSense" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/azul_pillsense</item>
        <item name="colorPrimaryVariant">@color/azul_noche</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/verde_menta</item>
        <item name="colorSecondaryVariant">@color/verde_bosque</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:windowBackground">@color/white</item>
        <item name="android:fontFamily">@font/atkinson_hyperlegible</item>
        <item name="fontFamily">@font/atkinson_hyperlegible</item>
        <item name="android:textColorPrimary">@color/azul_noche</item>
        <item name="android:textColorSecondary">@color/gris_pizarra</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
    </style>

    <!-- Splash screen (T031). Tras mostrarse, la app pasa al tema Theme.PillSense -->
    <style name="Theme.PillSense.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_fondo</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icono</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/splash_fondo</item>
        <item name="postSplashScreenTheme">@style/Theme.PillSense</item>
    </style>
</resources>