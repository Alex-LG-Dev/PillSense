<?xml version="1.0" encoding="utf-8"?>
<!-- Barra de acciones reutilizable. En cualquier pantalla: <include layout="@layout/app_bar" /> -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/contenedorBarra"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/azul_pillsense">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/barraAcciones"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/transparent"
        app:navigationIconTint="@color/white"
        app:titleTextAppearance="@style/TextAppearance.PillSense.TituloBarra"
        app:titleTextColor="@color/white" />

</FrameLayout>
