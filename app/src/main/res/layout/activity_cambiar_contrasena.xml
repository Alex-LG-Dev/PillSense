<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla CAMBIAR CONTRASEÑA (T036). Sigue el prototipo del Sprint 2. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_pantalla"
    android:fitsSystemWindows="true"
    tools:context=".CambiarContrasenaActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 1. BOTÓN VOLVER -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVolver"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Volver"
            android:textAllCaps="false"
            android:textColor="@color/texto_principal"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@color/fondo_tarjeta"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_arrow_back"
            app:iconTint="@color/texto_principal" />

        <!-- 2. TÍTULO Y AYUDA -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/contrasena_titulo"
            android:textColor="@color/texto_principal"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/contrasena_ayuda"
            android:textColor="@color/texto_secundario"
            android:textSize="16sp" />

        <!-- 3. CONTRASEÑA ACTUAL -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/contrasena_actual"
            android:textColor="@color/texto_principal"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etContrasenaActual"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:autofillHints="password"
            android:background="@drawable/bg_campo_perfil"
            android:hint="@string/contrasena_actual_hint"
            android:imeOptions="actionNext"
            android:inputType="textPassword"
            android:paddingHorizontal="16dp"
            android:textColor="@color/texto_principal"
            android:textColorHint="@color/texto_secundario"
            android:textSize="18sp" />

        <!-- 4. NUEVA CONTRASEÑA -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/contrasena_nueva"
            android:textColor="@color/texto_principal"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etContrasenaNueva"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:autofillHints="newPassword"
            android:background="@drawable/bg_campo_perfil"
            android:hint="@string/minimo_caracteres"
            android:imeOptions="actionNext"
            android:inputType="textPassword"
            android:paddingHorizontal="16dp"
            android:textColor="@color/texto_principal"
            android:textColorHint="@color/texto_secundario"
            android:textSize="18sp" />

        <!-- 5. REPETIR LA NUEVA -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/contrasena_repetir"
            android:textColor="@color/texto_principal"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etContrasenaRepetir"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:autofillHints="newPassword"
            android:background="@drawable/bg_campo_perfil"
            android:hint="@string/contrasena_repetir_hint"
            android:imeOptions="actionDone"
            android:inputType="textPassword"
            android:paddingHorizontal="16dp"
            android:textColor="@color/texto_principal"
            android:textColorHint="@color/texto_secundario"
            android:textSize="18sp" />

        <!-- 6. MOSTRAR LAS CONTRASEÑAS -->
        <CheckBox
            android:id="@+id/cbMostrarContrasenas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:buttonTint="@color/verde_menta"
            android:minHeight="48dp"
            android:text="@string/contrasena_mostrar"
            android:textColor="@color/texto_principal"
            android:textSize="16sp" />

        <!-- 7. HE OLVIDADO MI CONTRASEÑA -->
        <TextView
            android:id="@+id/tvContrasenaOlvidada"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:text="@string/contrasena_olvidada"
            android:textColor="@color/verde_menta"
            android:textSize="16sp" />

        <!-- 8. GUARDAR CONTRASEÑA -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCambiarContrasena"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="32dp"
            android:text="@string/contrasena_btn_guardar"
            android:textAllCaps="false"
            android:textColor="@color/azul_noche"
            android:textSize="20sp"
            android:textStyle="bold"
            app:backgroundTint="@color/verde_menta"
            app:cornerRadius="16dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
