<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla PASTILLAS (pestaña 3). De momento con datos de ejemplo del diseño. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_pantalla">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 1. TÍTULO Y CONTADOR -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mis pastillas"
            android:textColor="@color/texto_principal"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvNumMedicamentos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="4 medicamentos"
            android:textColor="@color/texto_secundario"
            android:textSize="14sp" />

        <!-- 2. LISTA: las tarjetas (item_medicamento.xml) se añaden desde PastillasFragment.java -->
        <LinearLayout
            android:id="@+id/listaMedicamentos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical" />

        <!-- 3. BOTÓN: añadir medicamento (de momento solo muestra un aviso) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAnadirMedicamento"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="8dp"
            android:text="+  Añadir medicamento"
            android:textAllCaps="false"
            android:textColor="@color/azul_noche"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@color/verde_menta"
            app:cornerRadius="16dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
