<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="@dimen/espacio_pequeno"
    android:paddingBottom="@dimen/espacio_pequeno">

    <TextView
        android:id="@+id/tvInicial"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_avatar_equipo"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:textColor="@color/azul_noche"
        android:textSize="@dimen/texto_normal"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvNombreIntegrante"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/espacio_medio"
        android:layout_weight="1"
        android:textColor="@color/azul_noche"
        android:textSize="@dimen/texto_normal" />
</LinearLayout>
