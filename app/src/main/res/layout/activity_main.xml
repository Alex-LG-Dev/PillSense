<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_pantalla"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <!-- Barra de acciones: nombre de la app y menú con "Acerca de"[cite: 60] -->
    <include layout="@layout/app_bar" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/contenido"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="@dimen/margen_pantalla">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnIniciarSesion"
                android:layout_width="match_parent"
                android:layout_height="@dimen/altura_boton"
                android:text="@string/btn_iniciar_sesion"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="@dimen/texto_boton"
                android:textStyle="bold"
                app:backgroundTint="@color/verde_menta"
                app:cornerRadius="@dimen/radio_esquina" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRegistrarse"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/altura_boton"
                android:layout_marginTop="@dimen/espacio_medio"
                android:text="@string/btn_registrarse"
                android:textAllCaps="false"
                android:textColor="@color/texto_principal"
                android:textSize="@dimen/texto_boton"
                android:textStyle="bold"
                app:cornerRadius="@dimen/radio_esquina"
                app:strokeColor="@color/azul_pillsense"
                app:strokeWidth="2dp" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</LinearLayout>