<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:background="@drawable/bg_fila_paciente"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp">

    <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_avatar_cuidador"
        android:contentDescription="@null"
        android:padding="8dp"
        android:src="@drawable/ic_persona"
        app:tint="@color/texto_secundario" />

    <TextView
        android:id="@+id/tvNombrePaciente"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:text="Carmen"
        android:textColor="@color/texto_principal"
        android:textSize="@dimen/texto_normal"
        android:textStyle="bold" />

    <!-- Quitar este paciente de la lista (desvincular) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnQuitarPaciente"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0"
        android:minWidth="0dp"
        android:text="Quitar"
        android:textAllCaps="false"
        android:textColor="@color/boton_ayuda"
        android:textSize="16sp" />
</LinearLayout>