<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla EDITAR PERFIL (T036): cambiar nombre y teléfono. Sigue el prototipo del Sprint 2. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_pantalla"
    android:fitsSystemWindows="true"
    tools:context=".EditarPerfilActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 1. BOTÓN VOLVER -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVolver"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Volver"
            android:textAllCaps="false"
            android:textColor="@color/texto_principal"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@color/fondo_tarjeta"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_arrow_back"
            app:iconTint="@color/texto_principal" />

        <!-- 2. TÍTULO -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Editar perfil"
            android:textColor="@color/texto_principal"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- 3. FOTO Y BOTÓN "CAMBIAR FOTO" -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivFotoEditar"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_avatar_perfil"
                android:contentDescription="Foto de perfil"
                android:padding="14dp"
                android:src="@drawable/ic_persona" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCambiarFoto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Cambiar foto"
                android:textAllCaps="false"
                android:textColor="@color/texto_principal"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@color/fondo_tarjeta"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_camara"
                app:iconTint="@color/texto_principal" />
        </LinearLayout>

        <!-- 4. NOMBRE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/label_nombre_editar"
            android:textColor="@color/texto_principal"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etNombrePerfil"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:autofillHints="name"
            android:background="@drawable/bg_campo_perfil"
            android:hint="@string/hint_nombre_editar"
            android:imeOptions="actionNext"
            android:inputType="textPersonName|textCapWords"
            android:paddingHorizontal="16dp"
            android:textColor="@color/texto_principal"
            android:textColorHint="@color/texto_secundario"
            android:textSize="18sp" />

        <!-- 5. CORREO (no se puede cambiar) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/hint_correo_label"
            android:textColor="@color/texto_principal"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etCorreoPerfil"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_campo_perfil"
            android:enabled="false"
            android:hint="@string/hint_correo"
            android:inputType="textEmailAddress"
            android:paddingHorizontal="16dp"
            android:textColor="@color/texto_secundario"
            android:textColorHint="@color/texto_secundario"
            android:textSize="18sp" />

        <!-- 6. TELÉFONO (opcional) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/label_telefono"
            android:textColor="@color/texto_principal"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etTelefonoPerfil"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:autofillHints="phone"
            android:background="@drawable/bg_campo_perfil"
            android:hint="@string/hint_telefono"
            android:imeOptions="actionDone"
            android:inputType="phone"
            android:paddingHorizontal="16dp"
            android:textColor="@color/texto_principal"
            android:textColorHint="@color/texto_secundario"
            android:textSize="18sp" />

        <!-- 7. FILA "CAMBIAR CONTRASEÑA" (solo cuentas con correo y contraseña) -->
        <LinearLayout
            android:id="@+id/filaCambiarContrasena"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_campo_perfil"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_candado"
                app:tint="@color/texto_principal" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:text="@string/contrasena_titulo"
                android:textColor="@color/texto_principal"
                android:textSize="18sp" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_chevron_derecha"
                app:tint="@color/texto_secundario" />
        </LinearLayout>

        <!-- Aviso para las cuentas de Google o Facebook (no tienen contraseña aquí) -->
        <TextView
            android:id="@+id/tvContrasenaOtraCuenta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:textColor="@color/texto_secundario"
            android:textSize="16sp"
            android:visibility="gone"
            tools:text="Tu cuenta usa Google para iniciar sesión."
            tools:visibility="visible" />

        <!-- 8. GUARDAR CAMBIOS -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGuardarPerfil"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="40dp"
            android:text="@string/perfil_btn_guardar"
            android:textAllCaps="false"
            android:textColor="@color/azul_noche"
            android:textSize="20sp"
            android:textStyle="bold"
            app:backgroundTint="@color/verde_menta"
            app:cornerRadius="16dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
