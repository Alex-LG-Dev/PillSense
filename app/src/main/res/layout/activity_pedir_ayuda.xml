<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_pantalla"
    android:orientation="vertical">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingTop="8dp">

        <ImageButton
            android:id="@+id/btnVolver"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Volver"
            android:scaleType="center"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/texto_principal" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="Pedir ayuda"
            android:textColor="@color/texto_principal"
            android:textSize="26sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Contenido -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="24dp">

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Título -->
        <TextView
            android:id="@+id/tvTituloCuidadores"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="¿A quién quieres llamar?"
            android:textColor="@color/texto_principal"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Aquí el código pone un botón por cada cuidador -->
        <LinearLayout
            android:id="@+id/listaCuidadores"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- Sin cuidadores: solo sale si no tiene ninguno -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVerMiCodigo"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/azul_pillsense"
            android:letterSpacing="0"
            android:text="Ver mi código"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="21sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:cornerRadius="16dp" />

        <!-- Añadir otro cuidador: lleva a "Mi código" -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAnadirCuidador"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:letterSpacing="0"
            android:text="+ Añadir otro cuidador"
            android:textAllCaps="false"
            android:textColor="?attr/colorPrimary"
            android:textSize="18sp" />
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />


        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:alpha="0.3"
            android:background="@color/texto_secundario" />

        <!-- Emergencia: SOLO VISUAL (el botón no hace nada) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="¿Es una emergencia?"
            android:textColor="@color/texto_principal"
            android:textSize="21sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLlamar112"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="10dp"
            android:letterSpacing="0"
            android:text="Llamar al 112"
            android:textAllCaps="false"
            android:textColor="@color/boton_ayuda"
            android:textSize="20sp"
            android:textStyle="bold"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_telefono"
            app:iconGravity="textStart"
            app:iconSize="24dp"
            app:iconTint="@color/boton_ayuda"
            app:strokeColor="@color/boton_ayuda"
            app:strokeWidth="2dp" />

        <!-- Cancelar: vuelve atrás -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelar"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="60dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:letterSpacing="0"
            android:text="Cancelar"
            android:textAllCaps="false"
            android:textColor="@color/texto_principal"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>