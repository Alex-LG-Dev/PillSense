<?xml version="1.0" encoding="utf-8"?>
<!-- 1. El DrawerLayout es el contenedor raíz que permite abrir el menú lateral deslizando o por botón -->
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".PrincipalActivity">

    <!-- 2. Tu diseño original se mantiene intacto aquí dentro -->
    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Barra de acciones (la misma que en el resto de pantallas) -->
        <include layout="@layout/app_bar" />

        <!-- Aquí se ven las pantallas de las pestañas; se puede deslizar -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Línea fina encima de las pestañas -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:alpha="0.3"
            android:background="@color/pestana_inactiva" />

        <!-- Las 4 pestañas, abajo como en el diseño -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:tabGravity="fill"
            app:tabIconTint="@color/color_pestana"
            app:tabIndicatorHeight="0dp"
            app:tabMode="fixed"
            app:tabTextAppearance="@style/TextAppearance.PillSense.Pestana"
            app:tabTextColor="@color/color_pestana"
            android:background="@color/fondo_pantalla"/>

    </LinearLayout>

    <!-- 3. El menú lateral desplegable que aparecerá al pulsar el icono o deslizar -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/fondo_pantalla"
        app:itemTextColor="@color/texto_principal"
        app:itemIconTint="@color/texto_principal"
        app:headerLayout="@layout/nav_header"
        app:menu="@menu/drawer_menu" />

</androidx.drawerlayout.widget.DrawerLayout>