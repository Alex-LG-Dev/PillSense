<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Splash screen (T031) en Android 12 o superior: añade la imagen de marca
         ("Cuidamos de ti") en la parte baja. En versiones anteriores no se muestra. -->
    <style name="Theme.PillSense.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_fondo</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icono</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/splash_fondo</item>
        <item name="android:windowSplashScreenBrandingImage">@drawable/splash_marca</item>
        <item name="postSplashScreenTheme">@style/Theme.PillSense</item>
    </style>
</resources>
